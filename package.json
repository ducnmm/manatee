{
  "name": "manatee",
  "version": "0.1.0",
  "private": true,
  "description": "Social cross-chain send: lock on Sepolia, mint on Creditcoin after Attestcoin verify",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "worker": "tsx worker/index.ts",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/*.test.ts",
    "test:contracts": "forge test --root contracts",
    "build:contracts": "forge build --root contracts"
  },
  "dependencies": {
    "@gluwa/usc-sdk": "0.18.0",
    "dotenv": "17.4.2",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@gluwa/usc-contracts": "0.1.2",
    "@openzeppelin/contracts": "5.4.0",
    "@types/node": "24.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
