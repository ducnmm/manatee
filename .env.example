# Sepolia chain key on CC3 testnet (NOT chainId 11155111)
SOURCE_CHAIN_KEY=1
SOURCE_CHAIN_RPC_URL=https://sepolia.infura.io/v3/<your_key>
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network

# Fresh test wallet — no real funds. Same key works on both EVM chains.
PRIVATE_KEY=

# Filled after deploy
SEPOLIA_MTEE=
SEPOLIA_LOCK=
CREDITCOIN_MINT=
CREDITCOIN_MTEE=

# Optional path override (default: ./registry.json)
# REGISTRY_PATH=./registry.json

# Worker start block. Default = chain tip (misses older locks).
# WORKER_FROM_BLOCK=

# Web + X. Do not set PORT on Railway (injected).
# X_BOT_HANDLE=ManateeWallet
# X_REPLY_AS=ManateeWallet
# TWITTERAPI_IO_API_KEY=
# TWITTERAPI_IO_LOGIN_COOKIES=
# TWITTERAPI_IO_PROXY=
# START_CHAIN_WORKER=1
# Seconds. Defaults: poll every 60s, search the last 120s. Demo: 5 / 10.
# POLL_INTERVAL_SEC=60
# SEARCH_LOOKBACK_SEC=120
# X OAuth2 (Continue with X). Add this exact callback on the X developer app:
# TWITTER_OAUTH2_CLIENT_ID=
# TWITTER_OAUTH2_CLIENT_SECRET=
# TWITTER_OAUTH2_REDIRECT_URI=https://manatee-production.up.railway.app/callback
